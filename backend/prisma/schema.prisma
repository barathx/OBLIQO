generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ObligationStatus {
  PENDING
  COMPLETED
  ARCHIVED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ObligationCategory {
  INSURANCE
  BILL
  SUBSCRIPTION
  DOCUMENT
  TAX
  APPOINTMENT
  SERVICE
  EDUCATION
  OTHER
}

enum ObligationSource {
  GMAIL
  TELEGRAM
  CALENDAR
  DOCUMENT
  MANUAL
}

enum ActivityType {
  OBLIGATION_DETECTED
  OBLIGATION_UPDATED
  OBLIGATION_ARCHIVED
  PRIORITY_UPDATED
  REMINDER_CREATED
  OBLIGATION_COMPLETED
  SCAN_STARTED
  SCAN_COMPLETED
  SCAN_FAILED
}

enum NotificationType {
  OBLIGATION_DETECTED
  DEADLINE_APPROACHING
  REMINDER
  COMPLETED
  SCAN_RESULT
  SYSTEM
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

enum ShieldStatus {
  INACTIVE
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id                String             @id @default(uuid())
  name              String?
  email             String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  obligations       Obligation[]
  sourceMessages    SourceMessage[]
  activityEvents    ActivityEvent[]
  notifications     Notification[]
  reminders         Reminder[]
  futureFunds       FutureFund[]
  shieldCommitments ShieldCommitment[]
}

model Obligation {
  id               String             @id @default(uuid())
  userId           String
  title            String
  description      String?
  category         ObligationCategory @default(OTHER)
  amount           Decimal?           @db.Decimal(10, 2)
  currency         String?            @default("USD")
  deadline         DateTime?
  priority         Priority           @default(MEDIUM)
  recurrence       Recurrence         @default(NONE)
  source           ObligationSource   @default(MANUAL)
  sourceMessageId  String?            @unique
  status           ObligationStatus   @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  completedAt      DateTime?

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage    SourceMessage?     @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  activityEvents   ActivityEvent[]
  notifications    Notification[]
  reminders        Reminder[]
  futureFund       FutureFund?
  shieldCommitment ShieldCommitment?

  @@index([userId])
  @@index([deadline])
  @@index([priority])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model SourceMessage {
  id          String           @id @default(uuid())
  userId      String
  source      ObligationSource
  externalId  String?
  sender      String?
  subject     String?
  content     String?
  receivedAt  DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligation  Obligation?

  @@index([userId])
  @@index([source])
}

model ActivityEvent {
  id           String       @id @default(uuid())
  userId       String
  obligationId String?
  type         ActivityType
  title        String
  description  String?
  createdAt    DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligation   Obligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([obligationId])
  @@index([createdAt])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  obligationId String?
  title        String
  message      String
  type         NotificationType
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligation   Obligation?      @relation(fields: [obligationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
}

model Reminder {
  id           String         @id @default(uuid())
  userId       String
  obligationId String
  remindAt     DateTime
  daysBefore   Int?
  status       ReminderStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligation   Obligation     @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([obligationId])
  @@index([remindAt])
  @@index([status])
}

model FutureFund {
  id                       String     @id @default(uuid())
  userId                   String
  obligationId             String     @unique
  targetAmount             Decimal    @db.Decimal(10, 2)
  preparedAmount           Decimal    @default(0) @db.Decimal(10, 2)
  recommendedMonthlyAmount Decimal?   @db.Decimal(10, 2)
  targetDate               DateTime?
  status                   String     @default("ACTIVE")
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligation               Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShieldCommitment {
  id                   String       @id @default(uuid())
  userId               String
  obligationId         String       @unique
  commitmentAmount     Decimal      @db.Decimal(10, 2)
  potentialConsequence String?
  status               ShieldStatus @default(INACTIVE)
  activatedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligation           Obligation   @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([userId])
}
